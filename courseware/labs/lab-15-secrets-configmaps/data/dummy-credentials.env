# ============================================================================
# TRAINING FIXTURE - CONTAINS NO REAL CREDENTIALS OF ANY KIND.
# Every value below is a self-describing placeholder. Nothing here authenticates
# to anything, anywhere. It exists only so the lab can run
#   kubectl create secret generic --from-env-file=data/dummy-credentials.env
# and then demonstrate that a Kubernetes Secret is base64-ENCODED, not
# encrypted.
#
# In a real system this file would never exist in a repository at all. See
# README section 4 Step 6 for the mitigations: encryption at rest, RBAC on
# secrets, and an external secret store.
# ============================================================================
BOOKING_DB_USERNAME=DUMMY-not-a-real-username
BOOKING_DB_PASSWORD=DUMMY-not-a-real-password-change-me
BOOKING_API_TOKEN=DUMMY-not-a-real-token-0000000000
